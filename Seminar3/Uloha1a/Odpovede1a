CREATE OR REPLACE PROCEDURE apply_regional_discount(region_name VARCHAR, discount_rate DECIMAL)
LANGUAGE plpgsql
AS $$
BEGIN
    UPDATE orders
    SET sales = sales * (1 - discount_rate)
    WHERE customer_id IN (
        SELECT customer_id
        FROM customers
        WHERE region = region_name
    );

    RAISE NOTICE 'Aplikovaná zľava % na objednávky zákazníkov z regiónu %.', discount_rate, region_name;
END;
$$;

CALL apply_regional_discount('West', 0.10);

