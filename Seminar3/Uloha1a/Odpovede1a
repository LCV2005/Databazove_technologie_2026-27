CREATE VIEW high_value_customers AS
SELECT 
    c.customer_id, 
    c.customer_name, 
    SUM(o.sales) AS total_sales
FROM 
    customers c
INNER JOIN 
    orders o ON c.customer_id = o.customer_id
GROUP BY 
    c.customer_id, 
    c.customer_name
HAVING 
    SUM(o.sales) > 2000;

2)

CREATE VIEW regional_monthly_sales AS
SELECT 
    c.region, 
    DATE_TRUNC('month', o.order_date)::DATE AS month, 
    SUM(o.sales) AS monthly_sales
FROM 
    customers c
INNER JOIN 
    orders o ON c.customer_id = o.customer_id
GROUP BY 
    c.region, 
    DATE_TRUNC('month', o.order_date)::DATE;

SELECT * 
FROM regional_monthly_sales 
WHERE region = 'West'
ORDER BY month;

3)

CREATE VIEW analyst_orders AS
SELECT 
    order_id,
    customer_id,
    product_id,
    sales,
    quantity,
    discount
FROM 
    orders;

